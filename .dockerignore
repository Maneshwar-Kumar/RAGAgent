# Docker build context exclusions (mirrors .gcloudignore).
# Deliberately does NOT include .gitignore. The image needs index/ but not the PDFs.
.git/
.gitignore
.gcloudignore
.github/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
*.env
manuals/*.pdf
manuals/uploads/
evals/
docs/
tests/
scripts/
deploy/
tmp/
