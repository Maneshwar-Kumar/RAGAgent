# Copy to bike_manual_agent/.env (adk web / adk run load it) or export in your shell.

# --- Option A (default): Vertex AI -------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Auth: run `gcloud auth application-default login` once.
# Or, for a quick session, export a short-lived token instead of ADC:
#   export GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token)

# --- Option B: Gemini API key (AI Studio) ------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-key

# --- Optional overrides -------------------------------------------------------
# RAGAGENT_CHAT_MODEL=gemini-3.8-flash
# RAGAGENT_EMBEDDING_MODEL=text-embedding-005
# RAGAGENT_TOP_K=6
