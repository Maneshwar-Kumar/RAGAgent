# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets / local config
.env
*.env
bike_manual_agent/.env

# The bundled manuals (manuals/*.pdf, see manuals/README.md) and their prebuilt index
# (index/<manual_id>/) are committed so nobody has to re-embed them. Manuals that riders
# upload, and their indexes, stay local.
manuals/uploads/
manuals/.*.partial.pdf
index/upload-*/

# ADK local session databases (adk web/run without --in_memory)
.adk/

# Local scratch
tmp/
evals/results/*.raw.json
